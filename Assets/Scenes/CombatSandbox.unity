  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0425\u0410\u0420\u0410\u041A\u0422\u0415\u0420\u0418\u0421\u0422\u0418\u041A\u0418
    \u041A\u041E\u0420\u0410\u0411\u041B\u042F\n\u0411\u0430\u0437\u0430 \u2192 \u043E\u0441\u043D\u0430\u0449\u0435\u043D\u0438\u0435
    (\u0431\u0435\u0437 \u0431\u043E\u0435\u0432\u044B\u0445 \u044D\u0444\u0444\u0435\u043A\u0442\u043E\u0432)\n\u041A\u043E\u0440\u043F\u0443\u0441:
    100 \u2192 100\n\u0429\u0438\u0442: 50 \u2192 50\n\u041C\u0430\u0441\u0441\u0430:
    2 \u2192 2\n\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C: 5 \u2192 5\n\u0422\u044F\u0433\u0430:
    12 \u2192 12\n\u041F\u043E\u0432\u043E\u0440\u043E\u0442: 300 \u2192 300 \xB0/\u0441\n\u0417\u0430\u0445\u0432\u0430\u0442:
    0,5 \u2192 0,5 \u0441\n\u042D\u043D\u0435\u0440\u0433\u0438\u044F \u043C\u0430\u043A\u0441.:
    100 \u2192 100\n\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435:
    12 \u2192 12/\u0441\n\u0423\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0441\u0442\u044C:
    0% \u2192 0%\n\u041E\u0445\u043B\u0430\u0436\u0434\u0435\u043D\u0438\u0435: 15
    \u2192 15/\u0441\n\n\u041E\u0420\u0423\u0416\u0418\u0415 (\u043A\u0430\u0436\u0434\u044B\u0439
    \u0441\u043B\u043E\u0442 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E)\n\n*
    \u041D\u043E\u043C\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u0439 DPS \u0431\u0435\u0437
    \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u0439 \u044D\u043D\u0435\u0440\u0433\u0438\u0438,\n\u043F\u0435\u0440\u0435\u0433\u0440\u0435\u0432\u0430,
    \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u0438 \u0438 \u0437\u0430\u0449\u0438\u0442\u044B
    \u0446\u0435\u043B\u0438.\n\u041E\u0431\u0449\u0438\u0439 DPS \u043D\u0435 \u0441\u0443\u043C\u043C\u0438\u0440\u0443\u0435\u0442\u0441\u044F."
